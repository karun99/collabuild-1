# Production deployment configuration for docker-compose.prod.yml
# Copy to `.env` and adjust values. NEVER commit real secrets.

# Public access port for the application
PORT=8080

# Secret used to sign JWT tokens. Generate a long random value:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret

# Public origin (for CORS). Leave default for same-origin via nginx.
CORS_ORIGIN=http://localhost:8080

# Optional: override the frontend's API/WS endpoints (default: same-origin via nginx)
VITE_API_URL=/api
VITE_WS_URL=/socket.io

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=collabuild

# Connection strings (overridden for containers automatically)
DATABASE_URL=postgresql://postgres:change-me@postgres:5432/collabuild
REDIS_URL=redis://redis:6379
